# Public custom-domain URL of this MCP resource server. Must end in /mcp.
OPS_PUBLIC_URL=https://mcp.example.com/mcp

# Auth0 tenant issuer and the API Identifier configured in Auth0.
AUTH0_ISSUER_URL=https://YOUR_AUTH0_TENANT_REGION.auth0.com/
AUTH0_AUDIENCE=https://mcp.example.com
AUTH0_JWKS_URL=https://YOUR_AUTH0_TENANT_REGION.auth0.com/.well-known/jwks.json
OPS_REQUIRED_SCOPE=simulation:use

# Render injects this from the attached Render Postgres database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional one-time value supplied during an OpenAI app-domain verification flow.
OPENAI_APPS_CHALLENGE=

# Trust only the reverse proxy connecting directly to the container.
FORWARDED_ALLOW_IPS=127.0.0.1
PORT=10000
